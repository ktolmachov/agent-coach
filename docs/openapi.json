{
  "components": {
    "schemas": {
      "AgentResultResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "answer_status": {
            "title": "Answer Status",
            "type": "string"
          },
          "sources": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Sources",
            "type": "array"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/AgentStepResponse"
            },
            "title": "Steps",
            "type": "array"
          },
          "stop_reason": {
            "title": "Stop Reason",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "trace": {
            "additionalProperties": true,
            "title": "Trace",
            "type": "object"
          }
        },
        "required": [
          "answer",
          "answer_status",
          "success",
          "stop_reason",
          "sources",
          "trace",
          "steps"
        ],
        "title": "AgentResultResponse",
        "type": "object"
      },
      "AgentStepResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "step_index": {
            "title": "Step Index",
            "type": "integer"
          },
          "tool_args": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Args"
          },
          "tool_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Error"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          },
          "tool_ok": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Ok"
          }
        },
        "required": [
          "step_index",
          "state"
        ],
        "title": "AgentStepResponse",
        "type": "object"
      },
      "ApiRunState": {
        "description": "Future-shaped public run lifecycle.",
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "ApiRunState",
        "type": "string"
      },
      "ContractResponse": {
        "properties": {
          "advertised_read_only_tools": {
            "items": {
              "type": "string"
            },
            "title": "Advertised Read Only Tools",
            "type": "array"
          },
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "contract_schema_hash": {
            "title": "Contract Schema Hash",
            "type": "string"
          },
          "contract_schema_version": {
            "title": "Contract Schema Version",
            "type": "string"
          },
          "contracts": {
            "additionalProperties": true,
            "title": "Contracts",
            "type": "object"
          },
          "controlled_outcomes": {
            "items": {
              "type": "string"
            },
            "title": "Controlled Outcomes",
            "type": "array"
          },
          "fixture_schema_version": {
            "title": "Fixture Schema Version",
            "type": "string"
          }
        },
        "required": [
          "api_version",
          "contract_schema_version",
          "contract_schema_hash",
          "fixture_schema_version",
          "advertised_read_only_tools",
          "controlled_outcomes",
          "contracts"
        ],
        "title": "ContractResponse",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorEnvelope"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "auth": {
            "const": "none",
            "title": "Auth",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "production_auth": {
            "const": false,
            "title": "Production Auth",
            "type": "boolean"
          },
          "state_store": {
            "const": "ephemeral_in_memory",
            "title": "State Store",
            "type": "string"
          }
        },
        "required": [
          "ok",
          "api_version",
          "auth",
          "production_auth",
          "state_store"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RunAcceptedResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "ephemeral": {
            "const": true,
            "title": "Ephemeral",
            "type": "boolean"
          },
          "idempotency_key_id": {
            "title": "Idempotency Key Id",
            "type": "string"
          },
          "polling_url": {
            "title": "Polling Url",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ApiRunState"
          }
        },
        "required": [
          "api_version",
          "run_id",
          "state",
          "idempotency_key_id",
          "polling_url",
          "ephemeral"
        ],
        "title": "RunAcceptedResponse",
        "type": "object"
      },
      "RunCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "result_limit_chars": {
            "default": 16000,
            "maximum": 32000.0,
            "minimum": 1000.0,
            "title": "Result Limit Chars",
            "type": "integer"
          },
          "scenario_id": {
            "default": "grounded_success",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9_:-]+$",
            "title": "Scenario Id",
            "type": "string"
          }
        },
        "title": "RunCreateRequest",
        "type": "object"
      },
      "RunStatusResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentResultResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "scenario_id": {
            "title": "Scenario Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ApiRunState"
          }
        },
        "required": [
          "api_version",
          "run_id",
          "state",
          "scenario_id"
        ],
        "title": "RunStatusResponse",
        "type": "object"
      },
      "ToolCallRequest": {
        "additionalProperties": false,
        "properties": {
          "args": {
            "additionalProperties": true,
            "title": "Args",
            "type": "object"
          },
          "result_limit_chars": {
            "default": 16000,
            "maximum": 32000.0,
            "minimum": 1000.0,
            "title": "Result Limit Chars",
            "type": "integer"
          },
          "scenario_id": {
            "default": "grounded_success",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9_:-]+$",
            "title": "Scenario Id",
            "type": "string"
          }
        },
        "title": "ToolCallRequest",
        "type": "object"
      },
      "ToolCallResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "data": {
            "title": "Data"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "meta": {
            "additionalProperties": true,
            "title": "Meta",
            "type": "object"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "tool_name": {
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "api_version",
          "tool_name",
          "ok",
          "meta"
        ],
        "title": "ToolCallResponse",
        "type": "object"
      },
      "ToolListResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "tools": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "api_version",
          "tools"
        ],
        "title": "ToolListResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Deterministic localhost-only diploma review API.",
